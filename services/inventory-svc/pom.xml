<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.nagarro.demo</groupId>
        <artifactId>otel-kag-services</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>inventory-svc</artifactId>
    <name>inventory-svc</name>
    <description>Stock reservation against H2. Owns the connection pool that scenario 2 starves.</description>

    <dependencies>
        <dependency>
            <groupId>com.nagarro.demo</groupId>
            <artifactId>log-to-trace</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Bridged by the OTel Java agent at runtime; used to echo the trace id. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
